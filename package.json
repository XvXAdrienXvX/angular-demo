    "@angular/cli": "^21.2.28",
    "@angular/compiler-cli": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.1.12",
    "concurrently": "^10.0.6",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^28.0.0",
    "json-server": "^1.0.0-beta.15",
    "postcss": "^8.5.3",
